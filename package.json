  "homepage": "https://github.com/chinamcafee/expo-alipay-kit#readme",
  "devDependencies": {
    "@types/react": "~19.2.14",
    "expo": "56.0.8",
    "expo-module-scripts": "56.0.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
